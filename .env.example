# Optional: POST endpoint for contact + configurator forms. Without it, forms fall back to a prefilled email.
VITE_LEAD_ENDPOINT=
# Optional: base path when hosting under a sub-path, e.g. /preview/
VITE_BASE=
# Optional: "hash" for hosts that cannot rewrite deep links to index.html
VITE_ROUTER=
# Optional: ".json" for hosts that cannot serve .glb (loads the glTF-JSON twin models/<name>.glb.json instead)
VITE_MODEL_SUFFIX=
