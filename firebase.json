{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "_redirects"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/phenode/base-station",
        "destination": "/phenode#base-station",
        "type": 301
      },
      {
        "source": "/phenode/wireless-node",
        "destination": "/phenode#wireless-node",
        "type": 301
      },
      {
        "source": "/phenode/data-platform",
        "destination": "/phenode#data-platform",
        "type": 301
      },
      {
        "source": "/phenode/software",
        "destination": "/phenode#software",
        "type": 301
      },
      {
        "source": "/case-studies/*",
        "destination": "/case-studies",
        "type": 301
      },
      {
        "source": "/design-your-system",
        "destination": "/contact",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/!(*.*)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
